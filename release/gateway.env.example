# Production template. Generate unique values with the onprest-gateway binary
# from this archive; do not reuse the Quick Start credentials.
GATEWAY_AGENT_PUBLIC_KEY=replace-with-create-agent-secret-public-key
GATEWAY_API_KEYS_JSON='[{"name":"operator","key_hash":"replace-with-create-key-hash","capabilities":["replace-with-capability-name"]}]'

# Optional listen address. The default is :8080.
# GATEWAY_ADDR=:8080
