# Generate these values with the onprest-gateway binary from this archive.
GATEWAY_AGENT_PUBLIC_KEY=replace-with-create-agent-secret-public-key
GATEWAY_API_KEYS_JSON='[{"name":"operator","key_hash":"replace-with-create-key-hash","capabilities":["get_customer"]}]'

# Optional listen address. The default is :8080.
# GATEWAY_ADDR=:8080
